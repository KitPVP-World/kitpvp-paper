diff --git a/net/minecraft/world/entity/projectile/Projectile.java b/net/minecraft/world/entity/projectile/Projectile.java
index 6298e6de25f1dd9ff880a9ad2882dc7ccb2f100c..e4e7d23a2e738d6c0f77098304cd4726fcf236f5 100644
--- a/net/minecraft/world/entity/projectile/Projectile.java
+++ b/net/minecraft/world/entity/projectile/Projectile.java
@@ -35,6 +35,7 @@ import net.minecraft.world.phys.EntityHitResult;
 import net.minecraft.world.phys.HitResult;
 import net.minecraft.world.phys.Vec3;
 import org.jspecify.annotations.Nullable;
+import world.kitpvp.slime.server.KitPvPGameRulesImpl;
 
 public abstract class Projectile extends Entity implements TraceableEntity {
     private static final boolean DEFAULT_LEFT_OWNER = false;
@@ -143,6 +144,12 @@ public abstract class Projectile extends Entity implements TraceableEntity {
     }
 
     public Vec3 getMovementToShoot(double x, double y, double z, float velocity, float inaccuracy) {
+        // kitpvp start - Predictable Projectiles
+        if(((ServerLevel) this.level()).getGameRules().get(KitPvPGameRulesImpl.PREDICTABLE_PROJECTILES)) {
+            inaccuracy = 0;
+        }
+        // kitpvp end - Predictable Projectiles
+
         return new Vec3(x, y, z)
             .normalize()
             .add(
