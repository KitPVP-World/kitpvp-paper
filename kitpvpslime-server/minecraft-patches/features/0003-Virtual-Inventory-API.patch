         public void sendSlotChange(final AbstractContainerMenu container, final int slotIndex, final ItemStack itemStack) {
+            if (container == ServerPlayer.this.inventoryMenu && ServerPlayer.this.hasVirtualInventory()) return; // kitpvp - Virtual Inventory
             ServerPlayer.this.connection.send(new ClientboundContainerSetSlotPacket(container.containerId, container.incrementStateId(), slotIndex, itemStack));
         }
 
@@ -2041,6 +2042,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         this.containerMenu.removed(this);
         this.inventoryMenu.transferState(this.containerMenu);
         this.containerMenu = this.inventoryMenu;
+        this.virtualInventory(null); // kitpvp - Virtual Inventory
     }
 
     @Override
