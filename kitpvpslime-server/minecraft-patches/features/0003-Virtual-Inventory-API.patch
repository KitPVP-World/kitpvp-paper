         public void sendSlotChange(AbstractContainerMenu container, int slot, ItemStack stack) {
+            if (container == ServerPlayer.this.inventoryMenu && ServerPlayer.this.hasVirtualInventory()) return; // kitpvp - Virtual Inventory
             ServerPlayer.this.connection.send(new ClientboundContainerSetSlotPacket(container.containerId, container.incrementStateId(), slot, stack));
         }
 
@@ -2024,6 +2025,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         this.containerMenu.removed(this);
         this.inventoryMenu.transferState(this.containerMenu);
         this.containerMenu = this.inventoryMenu;
+        this.virtualInventory(null); // kitpvp - Virtual Inventory
     }
 
     @Override
