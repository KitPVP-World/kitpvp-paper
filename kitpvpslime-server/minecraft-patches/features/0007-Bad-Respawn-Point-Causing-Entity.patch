diff --git a/net/minecraft/world/damagesource/DamageSources.java b/net/minecraft/world/damagesource/DamageSources.java
index 8b583e92047a55e2703da744de33d8347dda07a0..f63b509674089c0ae8e3e06d9a60bdb9fabf1c09 100644
--- a/net/minecraft/world/damagesource/DamageSources.java
+++ b/net/minecraft/world/damagesource/DamageSources.java
@@ -260,8 +260,10 @@ public class DamageSources {
         return this.source(DamageTypes.SONIC_BOOM, entity);
     }
 
-    public DamageSource badRespawnPointExplosion(final Vec3 boomPos) {
-        return new DamageSource(this.damageTypes.getOrThrow(DamageTypes.BAD_RESPAWN_POINT), boomPos);
+    // kitpvp start - Bad Respawn Point Causing Entity
+    public DamageSource badRespawnPointExplosion(final Vec3 boomPos, @Nullable Entity causingEntity) {
+        return new DamageSource(this.damageTypes.getOrThrow(DamageTypes.BAD_RESPAWN_POINT), null, causingEntity, boomPos);
+        // kitpvp end - Bad Respawn Point Causing Entity
     }
 
     public DamageSource outOfBorder() {
